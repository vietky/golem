# Multi-stage Docker build for frontend with nginx
# Serves static assets at /apps/golem path
# Supports multi-architecture builds (amd64/arm64)

# Stage 1: Build the React app
FROM --platform=$BUILDPLATFORM node:18-alpine AS builder

ARG VITE_API_HOST=https://apps.vietky.io.vn/golem
ARG VITE_NGINX_HOST=https://statics.vietky.io.vn
ARG VITE_BASE_PATH=/golem/

ENV VITE_API_HOST=${VITE_API_HOST}
ENV VITE_NGINX_HOST=${VITE_NGINX_HOST}
ENV VITE_BASE_PATH=${VITE_BASE_PATH}

WORKDIR /app

# Copy package files
COPY web/react-frontend/package*.json ./

RUN echo "VITE_API_HOST is set to: $VITE_API_HOST"
RUN echo "VITE_NGINX_HOST is set to: $VITE_NGINX_HOST"

# Install dependencies
RUN npm ci --production=false

# Copy source code
COPY web/react-frontend/ ./

# Create public directory if it doesn't exist (for Vite build)
RUN mkdir -p public

# Build the app with production settings (use production mode to avoid publicDir issues)
RUN npm run release

# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy built assets to nginx html directory
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom nginx config
COPY deployment/base/golem-app/nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:80/apps/golem/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
